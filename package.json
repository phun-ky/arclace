{
  "name": "@phun-ky/arclace",
  "version": "0.3.0",
  "description": "Draw SVG lines between DOM elements. Framework agnostic, zero dependencies.",
  "keywords": [
    "connect",
    "connector",
    "svg",
    "line",
    "lines",
    "arrow",
    "edges",
    "diagram",
    "flow",
    "flowchart",
    "graph",
    "dom",
    "bezier"
  ],
  "homepage": "https://phun-ky.net/arclace/",
  "bugs": {
    "url": "https://github.com/phun-ky/arclace/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phun-ky/arclace.git"
  },
  "license": "MIT",
  "author": "Alexander Vassbotn Røyne-Helgesen <alexander@phun-ky.net>",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/arclace.d.ts",
      "default": "./dist/arclace.js"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json",
    "./dist/*": "./dist/*"
  },
  "main": "./dist/arclace.js",
  "module": "./dist/arclace.js",
  "types": "./dist/arclace.d.ts",
  "unpkg": "./dist/arclace.umd.cjs",
  "jsdelivr": "./dist/arclace.umd.cjs",
  "files": [
    "dist",
    "src",
    "!src/**/__tests__",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "bestpractices:url": "node scripts/bestpractices-url.mjs",
    "build": "rm -rf dts && vite build && tsc -p tsconfig.build.json && rollup -c",
    "check:bestpractices": "node scripts/check-bestpractices.mjs",
    "check:pack": "node scripts/check-pack.mjs",
    "commit": "npx git-cz",
    "dev": "vite --force",
    "docs:gen": "typedoc",
    "docs:check": "typedoc --emit none --treatWarningsAsErrors",
    "predocs:dev": "npm run docs:gen",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "lint": "eslint .",
    "logo": "node scripts/render-logo.mjs",
    "prepare": "git config core.hooksPath .githooks || true",
    "prepublishOnly": "npm run build",
    "preview": "vite preview",
    "release": "release-it",
    "release:dry-run": ".github/scripts/release-dry-run.sh",
    "test": "node --import tsx --import global-jsdom/register --test --no-warnings 'src/**/__tests__/**/*.spec.ts'",
    "pretest:ci": "rm -rf coverage && mkdir -p coverage",
    "test:ci": "node --import tsx --import global-jsdom/register --test --no-warnings --experimental-test-coverage --test-coverage-include='src/**/*.ts' --test-coverage-exclude='src/**/__tests__/**' --test-coverage-exclude='src/types.ts' --test-coverage-lines=99 --test-coverage-functions=100 --test-coverage-branches=95 --test-reporter=cobertura --test-reporter-destination=coverage/cobertura-coverage.xml --test-reporter=spec --test-reporter-destination=stdout 'src/**/__tests__/**/*.spec.ts'",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@release-it/conventional-changelog": "^12.0.2",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@types/node": "^24.19.2",
    "cobertura": "^1.0.3",
    "eslint": "^10.14.0",
    "eslint-config-phun-ky": "^2.0.10",
    "fast-check": "^4.10.2",
    "git-cz": "^4.9.0",
    "global-jsdom": "^30.0.0",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "release-it": "^21.1.2",
    "rollup": "^4.67.4",
    "rollup-plugin-dts": "^6.5.1",
    "tsx": "^4.23.15",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.14.1",
    "typedoc-vitepress-theme": "^1.1.4",
    "typescript": "~5.7.2",
    "vite": "^6.2.0",
    "vitepress": "^1.6.4"
  },
  "overrides": {
    "get-uri": {
      "basic-ftp": "^6.2.5"
    },
    "micromark-extension-math": {
      "katex": "^0.18.2"
    },
    "vitepress": {
      "vite": "^6.4.5"
    }
  }
}
