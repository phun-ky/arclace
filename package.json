{
  "name": "@phun-ky/connect-the-things",
  "version": "0.0.0",
  "description": "Draw SVG lines between DOM elements. Framework agnostic, zero dependencies.",
  "keywords": [
    "connect",
    "connector",
    "svg",
    "line",
    "lines",
    "arrow",
    "edges",
    "diagram",
    "flow",
    "flowchart",
    "graph",
    "dom",
    "bezier"
  ],
  "homepage": "https://github.com/phun-ky/connect-the-things#readme",
  "bugs": {
    "url": "https://github.com/phun-ky/connect-the-things/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phun-ky/connect-the-things.git"
  },
  "license": "MIT",
  "author": "Alexander Vassbotn Røyne-Helgesen <alexander@phun-ky.net>",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/connect-the-things.d.ts",
      "default": "./dist/connect-the-things.js"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json",
    "./dist/*": "./dist/*"
  },
  "main": "./dist/connect-the-things.js",
  "module": "./dist/connect-the-things.js",
  "types": "./dist/connect-the-things.d.ts",
  "unpkg": "./dist/connect-the-things.umd.cjs",
  "jsdelivr": "./dist/connect-the-things.umd.cjs",
  "files": [
    "dist",
    "src",
    "!src/**/__tests__",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "rm -rf dts && vite build && tsc -p tsconfig.build.json && rollup -c",
    "check:pack": "node scripts/check-pack.mjs",
    "commit": "npx git-cz",
    "dev": "vite --force",
    "docs:gen": "typedoc",
    "lint": "eslint src",
    "prepublishOnly": "npm run build",
    "preview": "vite preview",
    "release": "release-it",
    "test": "node --import tsx --import global-jsdom/register --test --no-warnings 'src/**/__tests__/**/*.spec.ts'",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@release-it/conventional-changelog": "^10.0.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@types/node": "^26.6.6",
    "eslint": "^9.26.0",
    "eslint-config-phun-ky": "^1.0.0",
    "git-cz": "^4.9.0",
    "global-jsdom": "^30.0.0",
    "globals": "^16.0.0",
    "jsdom": "^30.1.3",
    "prettier": "3.5.1",
    "publint": "^0.3.25",
    "release-it": "^18.1.2",
    "rollup": "^4.67.4",
    "rollup-plugin-dts": "^6.5.1",
    "tsx": "^4.23.15",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.14.1",
    "typescript": "~5.7.2",
    "vite": "^6.2.0"
  }
}
