{
  "name": "@phun-ky/connect-the-things",
  "version": "0.0.0",
  "description": "Draw SVG lines between DOM elements. Framework agnostic, zero dependencies.",
  "keywords": [
    "connect",
    "connector",
    "svg",
    "line",
    "lines",
    "arrow",
    "edges",
    "diagram",
    "flow",
    "flowchart",
    "graph",
    "dom",
    "bezier"
  ],
  "homepage": "https://github.com/phun-ky/connect-the-things#readme",
  "bugs": {
    "url": "https://github.com/phun-ky/connect-the-things/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phun-ky/connect-the-things.git"
  },
  "license": "MIT",
  "author": "Alexander Vassbotn Røyne-Helgesen <alexander@phun-ky.net>",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/connect-the-things.js",
      "require": "./dist/connect-the-things.umd.cjs"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "main": "./dist/connect-the-things.umd.cjs",
  "module": "./dist/connect-the-things.js",
  "types": "./dist/types/index.d.ts",
  "unpkg": "./dist/connect-the-things.umd.cjs",
  "jsdelivr": "./dist/connect-the-things.umd.cjs",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.8.0"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "commit": "npx git-cz",
    "dev": "vite --force",
    "docs:gen": "typedoc",
    "lint": "eslint src",
    "prepublishOnly": "npm run build",
    "preview": "vite preview",
    "release": "release-it",
    "test": "node --import tsx --import global-jsdom/register --test --no-warnings 'src/**/__tests__/**/*.spec.ts'",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@release-it/conventional-changelog": "^10.0.0",
    "@types/node": "^26.6.6",
    "eslint": "^9.26.0",
    "eslint-config-phun-ky": "^1.0.0",
    "git-cz": "^4.9.0",
    "global-jsdom": "^30.0.0",
    "globals": "^16.0.0",
    "jsdom": "^30.1.3",
    "prettier": "3.5.1",
    "release-it": "^18.1.2",
    "tsx": "^4.23.15",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.14.1",
    "typescript": "~5.7.2",
    "vite": "^6.2.0"
  }
}
