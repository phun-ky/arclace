  "compilerOptions": {
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false,
    "declarationDir": "./dts",
    "stripInternal": true
  },
  "include": ["src"],
  "exclude": ["**/__tests__/**"]
}
