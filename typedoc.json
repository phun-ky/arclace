{
  "$schema": "https://typedoc-plugin-markdown.org/schema.json",
  "entryPoints": ["src/index.ts"],
  "tsconfig": "tsconfig.build.json",
  "out": "docs/api",
  "docsRoot": "./docs",
  "plugin": ["typedoc-plugin-markdown", "typedoc-vitepress-theme"],
  "excludeInternal": true,
  "excludePrivate": true,
  "readme": "none",
  "githubPages": false,
  "gitRevision": "main",
  "hideGenerator": true
}
